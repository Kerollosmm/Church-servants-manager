rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════════
    // DATA MODEL REFERENCE
    // ═══════════════════════════════════════════════════════════════
    //
    // servants/{uid}
    //   uid, name, email, role ("admin"|"servant"), imageUrl,
    //   groupId, assignedTeamIds[], assignedTeamId (legacy),
    //   assignedSectorIds[], isArchived, syncStatus, clientUpdatedAt
    //
    // Students/{studentId}
    //   uid, name, mobile, group, classId, sectorId,
    //   isArchived, syncStatus, clientUpdatedAt
    //
    // Students/{studentId}/PointsLedger/{transactionId}
    //   id, studentId, delta, runningTotal, reason,
    //   issuedByUid, issuedByName, createdAt, syncStatus
    //
    // AttendanceSessions/{sessionId}
    //   teamId, startsAt, endsAt, isClosed, studentIdsSnapshot[]
    //
    // AttendanceSessions/{sessionId}/marks/{studentDocId}
    //   studentId, status ("present"|"absent"|"late"),
    //   markedByUserId, updatedAt
    //
    // Classes/{classId}
    //   name, groupId, isArchived
    //
    // ═══════════════════════════════════════════════════════════════


    // ───────────────────────────────────────────────────────────────
    // IDENTITY HELPERS  (zero Firestore reads)
    // ───────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // ─── Document-based RBAC (Spark Plan: zero Cloud Functions) ───
    // Firestore caches get() results within a single rule evaluation,
    // so multiple calls to getCallerData() cost only 1 read.

    function getCallerData() {
      return get(/databases/$(database)/documents/Users/$(request.auth.uid)).data;
    }

    function callerRole() {
      return getCallerData().get('role', '');
    }

    function isAdmin() {
      return isSignedIn() && callerRole() == 'admin';
    }

    function isServantOrAdmin() {
      return isSignedIn() && callerRole() in ['admin', 'servant'];
    }

    // ───────────────────────────────────────────────────────────────
    // SECTOR-SCOPED RBAC HELPERS
    // ───────────────────────────────────────────────────────────────

    function callerManagesSector(sectorId) {
      let callerData = getCallerData();
      let callerSectors = callerData.get('assignedSectorIds', []);
      return isServantOrAdmin() && (
        isAdmin() ||
        sectorId in callerSectors
      );
    }

    // Returns true when the caller can manage the student's sector.
    function callerManagesStudentSector(studentData) {
      return studentData != null &&
             callerManagesSector(studentData.get('sectorId', '__none__'));
    }

    // Returns true when the caller can manage the student's sector or team.
    function callerManagesStudent(studentData) {
      return studentData != null && (
        callerManagesSector(studentData.get('sectorId', '__none__')) ||
        callerManagesTeam(studentData.get('classId', '__none__'))
      );
    }

    // ───────────────────────────────────────────────────────────────
    // TEAM / CLASS HELPERS  (preserves existing team-based access)
    // ───────────────────────────────────────────────────────────────

    function callerManagesTeam(classId) {
      let callerData = getCallerData();
      let callerTeamId = callerData.get('assignedTeamId', '');
      let callerTeamIds = callerData.get('assignedTeamIds', []);
      return isServantOrAdmin() && (
        isAdmin() ||
        classId == callerTeamId ||
        classId in callerTeamIds
      );
    }

    // ───────────────────────────────────────────────────────────────
    // FIELD GUARDS
    // ───────────────────────────────────────────────────────────────

    function isImmutable(field) {
      return !(field in request.resource.data) ||
             request.resource.data[field] == resource.data[field];
    }

    function isPrivilegedStudentField() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'role', 'uid', 'isArchived', 'classId', 'group',
        'sectorId', 'assignedTeamIds', 'assignedTeamId'
      ]);
    }

    // ───────────────────────────────────────────────────────────────
    // VALIDATION HELPERS
    // ───────────────────────────────────────────────────────────────

    function validName(field) {
      return field is string && field.size() > 0 && field.size() <= 200;
    }

    function validPointsDelta() {
      let d = request.resource.data.delta;
      return d is int && d != 0 && d >= -1000 && d <= 1000;
    }

    // ═══════════════════════════════════════════════════════════════
    // DEFAULT DENY
    // ═══════════════════════════════════════════════════════════════

    match /{document=**} {
      allow read, write: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    // SERVANTS COLLECTION
    // ═══════════════════════════════════════════════════════════════

    match /Users/{servantId} {
      // Own profile, admin, or any signed-in servant.
      allow read: if isSignedIn() && (servantId == uid() || isServantOrAdmin());

      // Only admin can create servants/admins; authenticated users can self-register with default student role.
      allow create: if (
        isSignedIn() &&
        servantId == uid() &&
        request.resource.data.get('role', '') == 'student'
      ) || isAdmin();

      // Servants can edit their own non-privileged fields.
      allow update: if isSignedIn() && (
        isAdmin() || (
          servantId == uid() &&
          isImmutable('role') &&
          isImmutable('uid') &&
          isImmutable('isArchived') &&
          isImmutable('assignedTeamIds') &&
          isImmutable('assignedSectorIds')
        )
      );

      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════
    // STUDENTS COLLECTION
    // ═══════════════════════════════════════════════════════════════

    match /Students/{studentId} {

      // Student reads their own doc; servants read within their sectors/teams.
      allow read: if isSignedIn() && (
        studentId == uid() ||
        resource.data.uid == uid() ||
        isAdmin() ||
        (callerManagesStudent(resource.data) && resource.data.get('isArchived', false) == false)
      );

      // Admin or sector-owning servant can create a student.
      allow create: if isSignedIn() && (
        isAdmin() ||
        (
          isServantOrAdmin() &&
          callerManagesSector(request.resource.data.get('sectorId', '__none__')) &&
          callerManagesTeam(request.resource.data.get('classId', '__none__')) &&
          request.resource.data.get('isArchived', false) == false &&
          validName(request.resource.data.get('name', ''))
        )
      );

      // Servant can update non-privileged fields of students in their sector/team.
      allow update: if isSignedIn() && (
        isAdmin() || (
          isServantOrAdmin() &&
          callerManagesStudent(resource.data) &&
          !isPrivilegedStudentField() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'mobile', 'birthdate', 'address',
            'mother_number', 'father_number', 'imageUrl',
            'notes', 'grade', 'education_stage',
            'school_college', 'father_of_confession', 'updatedAt',
            'syncStatus', 'clientUpdatedAt', 'attendanceSummary'
          ]) &&
          (!('name' in request.resource.data) || validName(request.resource.data.name))
        )
      );

      allow delete: if isAdmin();

      // ─── PointsLedger Sub-collection ─────────────────────────────
      //
      // /Students/{studentId}/PointsLedger/{transactionId}
      //
      // • Create: sector/team-owning servant only.
      // • Read:   student reads own; sector/team servant reads; admin reads all.
      // • Update/Delete: FORBIDDEN for all (immutable ledger).

      match /PointsLedger/{transactionId} {

        allow read: if isSignedIn() && (
          studentId == uid() ||
          isAdmin() ||
          (isServantOrAdmin() && callerManagesStudent(get(/databases/$(database)/documents/Students/$(studentId)).data))
        );

        allow create: if isSignedIn() && (
          isAdmin() || (
            isServantOrAdmin() &&
            callerManagesStudent(get(/databases/$(database)/documents/Students/$(studentId)).data) &&
            validPointsDelta() &&
            request.resource.data.keys().hasAll([
              'studentId', 'delta', 'runningTotal',
              'reason', 'issuedByUid', 'issuedByName', 'createdAt'
            ]) &&
            request.resource.data.issuedByUid == uid()
          )
        );

        // Immutable — no update or delete from client.
        allow update, delete: if false;
      }

      // ─── AttendanceSessions Sub-collection ────────────────────────
      //
      // /Students/{studentId}/AttendanceSessions/{sessionId}
      //
      // Written by closeSession flow (assigned servant or admin).
      // Read: admin, student-owner, or assigned servant.

      match /AttendanceSessions/{sessionId} {
        allow read: if isSignedIn() && (
          studentId == uid() ||
          isAdmin() ||
          (isServantOrAdmin() && callerManagesStudent(get(/databases/$(database)/documents/Students/$(studentId)).data))
        );
        // All writes via closeSession flow (assigned servant or admin).
        allow create, update: if isSignedIn() && (
          isAdmin() || (
            isServantOrAdmin() &&
            callerManagesStudent(get(/databases/$(database)/documents/Students/$(studentId)).data)
          )
        );
        allow delete: if isAdmin();
      }

      // ─── PastoralRecords Sub-collection ──────────────────────────
      //
      // /Students/{studentId}/PastoralRecords/{recordId}
      //
      // • Create: sector/team-owning servant or admin.
      // • Read:   sector/team servant reads; admin reads all.
      // • Update/Delete: FORBIDDEN for all (immutable record).

      match /PastoralRecords/{recordId} {

        allow read: if isSignedIn() && (
          isAdmin() ||
          (isServantOrAdmin() && callerManagesStudent(get(/databases/$(database)/documents/Students/$(studentId)).data))
        );

        allow create: if isSignedIn() && (
          isAdmin() || (
            isServantOrAdmin() &&
            callerManagesStudent(get(/databases/$(database)/documents/Students/$(studentId)).data) &&
            request.resource.data.keys().hasAll([
              'recordId', 'studentId', 'type', 'summary',
              'visitedByUid', 'visitedByName', 'createdAt'
            ]) &&
            request.resource.data.visitedByUid == uid() &&
            request.resource.data.type in ['phoneCall', 'homeVisit', 'socialMedia']
          )
        );

        // Immutable — no update or delete from client.
        allow update, delete: if false;
      }
    }

    // ═══════════════════════════════════════════════════════════════
    // CLASSES COLLECTION
    // ═══════════════════════════════════════════════════════════════

    match /Classes/{classId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isSignedIn() && (
        isAdmin() || (
          callerManagesTeam(classId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'openSessionIds',
            'groupAttendanceSummary',
            'updatedAt'
          ])
        )
      );

      match /stats/{statDoc} {
        allow read: if isSignedIn() && (
          isAdmin() || callerManagesTeam(classId)
        );
        allow write: if isSignedIn() && (
          isAdmin() || callerManagesTeam(classId)
        );
      }
    }

    // ═══════════════════════════════════════════════════════════════
    // ATTENDANCE COLLECTION (canonical: /AttendanceSessions/{sessionId})
    // ═══════════════════════════════════════════════════════════════

    match /AttendanceSessions/{sessionId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        callerManagesTeam(resource.data.teamId) ||
        uid() in resource.data.get('studentIdsSnapshot', [])
      );
      allow create: if isSignedIn() && (
        isAdmin() || callerManagesTeam(request.resource.data.teamId)
      );
      allow update: if isSignedIn() && (
        isAdmin() || callerManagesTeam(resource.data.teamId)
      );
      allow delete: if isAdmin();

      match /records/{markId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          (resource.data.get('teamId', '') != '' ? callerManagesTeam(resource.data.teamId) : false) ||
          resource.data.get('studentId', '') == uid()
        );

        allow create: if isSignedIn() && (
          isAdmin() ||
          (request.resource.data.get('teamId', '') != '' ? callerManagesTeam(request.resource.data.teamId) : false)
        );

        allow update: if isSignedIn() && (
          isAdmin() ||
          (
            (resource.data.get('teamId', '') != '' ? callerManagesTeam(resource.data.teamId) : false) &&
            isImmutable('markedByUserId')
          )
        );

        allow delete: if isAdmin();
      }
    }

    // ═══════════════════════════════════════════════════════════════
    // RESULTS COLLECTION
    // ═══════════════════════════════════════════════════════════════

    match /results/{studentId} {
      allow read: if isSignedIn() && (
        studentId == uid() ||
        isAdmin() ||
        (isServantOrAdmin() && callerManagesStudent(get(/databases/$(database)/documents/Students/$(studentId)).data))
      );
      allow write: if isAdmin() || (
        isServantOrAdmin() &&
        callerManagesStudent(get(/databases/$(database)/documents/Students/$(studentId)).data)
      );

      match /terms/{termId} {
        allow read: if isSignedIn() && (
          studentId == uid() ||
          isAdmin() ||
          (isServantOrAdmin() && callerManagesStudent(get(/databases/$(database)/documents/Students/$(studentId)).data))
        );
        allow write: if isAdmin() || (
          isServantOrAdmin() &&
          callerManagesStudent(get(/databases/$(database)/documents/Students/$(studentId)).data)
        );
      }
    }

    // ═══════════════════════════════════════════════════════════════
    // SECTORS ANALYTICS (Pre-aggregated, read-only for authorized users)
    // ═══════════════════════════════════════════════════════════════

    match /SectorsAnalytics/{sectorId} {
      // Admin reads all; servants read only their assigned sectors.
      // Students: ZERO access.
      allow read: if isSignedIn() && (
        isAdmin() ||
        callerManagesSector(sectorId)
      );

      // Client writes FORBIDDEN — updated via Admin SDK or batch closure.
      allow write: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    // SUPPORTING COLLECTIONS
    // ═══════════════════════════════════════════════════════════════

    match /team_uniqueness_registry/{registryId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ─── Invitations ──────────────────────────────────────────────
    match /Invitations/{email} {
      allow read, write: if isAdmin();
    }

    // ─── Admin ────────────────────────────────────────────────────
    match /admin/{document=**} {
      allow read, write: if isAdmin();
    }

    // ─── Audit Logs ───────────────────────────────────────────────
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    // COLLECTION GROUP RULES (Required for global collection group queries)
    // ═══════════════════════════════════════════════════════════════

    match /{path=**}/AttendanceSessions/{sessionId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        callerManagesTeam(resource.data.teamId) ||
        uid() in resource.data.get('studentIdsSnapshot', [])
      );
    }

    match /{path=**}/records/{markId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.get('studentId', '') == uid() ||
        (resource.data.get('teamId', '') != '' ? callerManagesTeam(resource.data.teamId) : false)
      );
    }

    match /{path=**}/terms/{termId} {
      allow read: if isSignedIn() && (
        resource.data.studentId == uid() ||
        isAdmin() ||
        (isServantOrAdmin() && callerManagesStudent(get(/databases/$(database)/documents/Students/$(resource.data.studentId)).data))
      );
    }

    match /{path=**}/PastoralRecords/{recordId} {
      allow read: if isAdmin();
    }
  }
}