rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwnUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }

    function isServant() {
      return isAuthenticated() && getUserData().role == 'servant';
    }

    function isServantOrAdmin() {
      return isAdmin() || isServant();
    }

    // Users Collection (Central Identity)
    match /users/{userId} {
      // Least privilege:
      // - users can read only their own profile document
      // - admins can read any user profile and query/list users
      allow get: if isOwnUser(userId) || isAdmin();
      allow list: if isAdmin();

      // Allow users to update their own non-sensitive data, or Admin to update anything
      // Dual-write from Student repository updates this, so checking auth.uid is critical
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());

      // Allow creation only by Admin or if it's the user creating their own profile (e.g. signup)
      allow create: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // Students Collection
    match /students/{studentId} {
      // Students can read their own profile (if we link them) or Servants/Admins can read all
      allow read: if isAuthenticated();

      // Only Servants and Admins can create/update/delete students
      allow write: if isServantOrAdmin();
    }

    // Classes Collection
    match /classes/{classId} {
      allow read: if isAuthenticated();
      allow write: if isServantOrAdmin();
    }

    // Attendance Collection
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated();
      allow write: if isServantOrAdmin();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
