rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════════
    // DATA MODEL REFERENCE
    // ═══════════════════════════════════════════════════════════════
    //
    // servants/{uid}
    //   uid, name, email, role ("admin"|"servant"), imageUrl,
    //   groupId, assignedTeamIds[], assignedTeamId (legacy),
    //   assignedSectorIds[], isArchived, syncStatus, clientUpdatedAt
    //
    // Students/{studentId}
    //   uid, name, mobile, group, classId, sectorId,
    //   isArchived, syncStatus, clientUpdatedAt
    //
    // Students/{studentId}/PointsLedger/{transactionId}
    //   id, studentId, delta, runningTotal, reason,
    //   issuedByUid, issuedByName, createdAt, syncStatus
    //
    // attendance/{sessionId}
    //   teamId, startsAt, endsAt, isClosed, studentIdsSnapshot[]
    //
    // attendance/{sessionId}/marks/{studentDocId}
    //   studentId, status ("present"|"absent"|"late"),
    //   markedByUserId, updatedAt
    //
    // Classes/{classId}
    //   name, groupId, isArchived
    //
    // ═══════════════════════════════════════════════════════════════


    // ───────────────────────────────────────────────────────────────
    // IDENTITY HELPERS  (zero Firestore reads)
    // ───────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function dbRole() {
      let path = /databases/$(database)/documents/Users/$(uid());
      return exists(path) ? get(path).data.get('role', '') : '';
    }

    // Role comes from Custom Claims, with a fallback to the Firestore servant document (for Spark Plan / local emulator).
    function claimRole() {
      let claimR = request.auth.token.get('role', '');
      return claimR != '' ? claimR : dbRole();
    }

    function isAdmin() {
      return isSignedIn() && claimRole() == 'admin';
    }

    function isServantOrAdmin() {
      return isSignedIn() && claimRole() in ['admin', 'servant'];
    }

    // ───────────────────────────────────────────────────────────────
    // SERVANT PROFILE  (single cached read, stored in a let-binding)
    // ───────────────────────────────────────────────────────────────

    // One get() per top-level rule evaluation. All sector/team helpers
    // below reuse this binding — Firestore bills exactly ONE read per
    // request that calls servantData().
    function servantData() {
      return get(/databases/$(database)/documents/Users/$(uid())).data;
    }

    // ───────────────────────────────────────────────────────────────
    // SECTOR-SCOPED RBAC HELPERS
    // ───────────────────────────────────────────────────────────────

    // Returns true when the caller is a servant (or admin) and the given
    // sectorId is in their assignedSectorIds claim OR their servant document.
    // Claim path is always tried first (zero cost); document path is the
    // fallback for servants whose claims haven't refreshed yet.
    function callerManagesSector(sectorId) {
      let claimSectors = request.auth.token.get('assignedSectorIds', []);
      return isServantOrAdmin() && (
        isAdmin() ||
        sectorId in claimSectors ||
        sectorId in servantData().get('assignedSectorIds', [])
      );
    }

    // Returns true when the caller can manage the student's sector.
    function callerManagesStudentSector(studentData) {
      return studentData != null &&
             callerManagesSector(studentData.get('sectorId', '__none__'));
    }

    // ───────────────────────────────────────────────────────────────
    // TEAM / CLASS HELPERS  (preserves existing team-based access)
    // ───────────────────────────────────────────────────────────────

    function callerManagesTeam(classId) {
      let claimTeamId = request.auth.token.get('assignedTeamId', '');
      let claimTeamIds = request.auth.token.get('assignedTeamIds', []);
      return isServantOrAdmin() && (
        isAdmin() ||
        classId == claimTeamId ||
        classId in claimTeamIds ||
        classId in servantData().get('assignedTeamIds', [])
      );
    }

    // ───────────────────────────────────────────────────────────────
    // FIELD GUARDS
    // ───────────────────────────────────────────────────────────────

    function isImmutable(field) {
      return !(field in request.resource.data) ||
             request.resource.data[field] == resource.data[field];
    }

    function isPrivilegedStudentField() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'role', 'uid', 'isArchived', 'classId', 'group',
        'sectorId', 'assignedTeamIds', 'assignedTeamId'
      ]);
    }

    // ───────────────────────────────────────────────────────────────
    // VALIDATION HELPERS
    // ───────────────────────────────────────────────────────────────

    function validName(field) {
      return field is string && field.size() > 0 && field.size() <= 200;
    }

    function validPointsDelta() {
      let d = request.resource.data.delta;
      return d is int && d != 0 && d >= -1000 && d <= 1000;
    }

    // ═══════════════════════════════════════════════════════════════
    // DEFAULT DENY
    // ═══════════════════════════════════════════════════════════════

    match /{document=**} {
      allow read, write: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    // SERVANTS COLLECTION
    // ═══════════════════════════════════════════════════════════════

    match /Users/{servantId} {
      // Own profile, admin, or any signed-in servant.
      allow read: if isSignedIn() && (servantId == uid() || isServantOrAdmin());

      // Only admin can create servants/admins; authenticated users can self-register with default student role.
      allow create: if isAdmin() || (
        isSignedIn() &&
        servantId == uid() &&
        request.resource.data.get('role', '') == 'student'
      );

      // Servants can edit their own non-privileged fields.
      allow update: if isSignedIn() && (
        isAdmin() || (
          servantId == uid() &&
          isImmutable('role') &&
          isImmutable('uid') &&
          isImmutable('isArchived') &&
          isImmutable('assignedTeamIds') &&
          isImmutable('assignedSectorIds')
        )
      );

      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════
    // STUDENTS COLLECTION
    // ═══════════════════════════════════════════════════════════════

    match /Students/{studentId} {

      // Student reads their own doc; servants read within their sectors.
      allow read: if isSignedIn() && (
        studentId == uid() ||
        resource.data.uid == uid() ||
        isAdmin() ||
        callerManagesStudentSector(resource.data)
      );

      // Admin or sector-owning servant can create a student.
      allow create: if isSignedIn() && (
        isAdmin() ||
        (
          isServantOrAdmin() &&
          callerManagesSector(request.resource.data.get('sectorId', '__none__')) &&
          request.resource.data.get('isArchived', false) == false &&
          validName(request.resource.data.get('name', ''))
        )
      );

      // Servant can update non-privileged fields of students in their sector.
      allow update: if isSignedIn() && (
        isAdmin() || (
          isServantOrAdmin() &&
          callerManagesStudentSector(resource.data) &&
          !isPrivilegedStudentField() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'mobile', 'birthdate', 'address',
            'mother_number', 'father_number', 'imageUrl',
            'notes', 'grade', 'education_stage',
            'school_college', 'father_of_confession', 'updatedAt'
          ]) &&
          (!('name' in request.resource.data) || validName(request.resource.data.name))
        )
      );

      allow delete: if isAdmin();

      // ─── PointsLedger Sub-collection ─────────────────────────────
      //
      // /Students/{studentId}/PointsLedger/{transactionId}
      //
      // • Create: sector-owning servant only.
      // • Read:   student reads own; sector servant reads; admin reads all.
      // • Update/Delete: FORBIDDEN for all (immutable ledger; use Admin SDK).

      match /PointsLedger/{transactionId} {

        allow read: if isSignedIn() && (
          studentId == uid() ||
          isAdmin() ||
          callerManagesStudentSector(
            get(/databases/$(database)/documents/Students/$(studentId)).data
          )
        );

        allow create: if isSignedIn() && (
          isServantOrAdmin() &&
          callerManagesStudentSector(
            get(/databases/$(database)/documents/Students/$(studentId)).data
          ) &&
          validPointsDelta() &&
          request.resource.data.keys().hasAll([
            'studentId', 'delta', 'runningTotal',
            'reason', 'issuedByUid', 'issuedByName', 'createdAt'
          ]) &&
          request.resource.data.issuedByUid == uid()
        );

        // Immutable — no update or delete from client.
        allow update, delete: if false;
      }

      // ─── AttendanceHistory Sub-collection ────────────────────────
      //
      // /Students/{studentId}/AttendanceHistory/{sessionId}
      //
      // Managed exclusively by the sync engine via Admin SDK.
      // Client-side reads scoped to student-owner or admin.

      match /AttendanceHistory/{sessionId} {
        allow read: if isSignedIn() && (
          studentId == uid() ||
          isAdmin() ||
          callerManagesStudentSector(
            get(/databases/$(database)/documents/Students/$(studentId)).data
          )
        );
        // All writes via Admin SDK / sync engine only.
        allow write: if false;
      }

      // ─── PastoralRecords Sub-collection ──────────────────────────
      //
      // /Students/{studentId}/PastoralRecords/{recordId}
      //
      // • Create: sector-owning servant or admin.
      // • Read:   sector servant reads; admin reads all.
      // • Update/Delete: FORBIDDEN for all (immutable record).

      match /PastoralRecords/{recordId} {

        allow read: if isSignedIn() && (
          isAdmin() ||
          callerManagesStudentSector(
            get(/databases/$(database)/documents/Students/$(studentId)).data
          )
        );

        allow create: if isSignedIn() && (
          isServantOrAdmin() &&
          callerManagesStudentSector(
            get(/databases/$(database)/documents/Students/$(studentId)).data
          ) &&
          request.resource.data.keys().hasAll([
            'recordId', 'studentId', 'type', 'summary',
            'visitedByUid', 'visitedByName', 'createdAt'
          ]) &&
          request.resource.data.visitedByUid == uid() &&
          request.resource.data.type in ['phoneCall', 'homeVisit', 'socialMedia']
        );

        // Immutable — no update or delete from client.
        allow update, delete: if false;
      }
    }

    // ═══════════════════════════════════════════════════════════════
    // CLASSES COLLECTION
    // ═══════════════════════════════════════════════════════════════

    match /Classes/{classId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();

      match /stats/{statDoc} {
        allow read: if isSignedIn() && (
          isAdmin() || callerManagesTeam(classId)
        );
        allow write: if isSignedIn() && (
          isAdmin() || callerManagesTeam(classId)
        );
      }

      match /attendance_sessions/{sessionId} {
        allow read: if isSignedIn() && (
          isAdmin() || callerManagesTeam(classId)
        );
        allow create: if isSignedIn() && (
          isAdmin() || callerManagesTeam(classId)
        );
        allow update, delete: if isAdmin();

        match /marks/{markId} {
          allow read: if isSignedIn() && (
            isAdmin() ||
            callerManagesTeam(classId) ||
            uid() == markId.split('_')[0]
          );
          allow create, update: if isSignedIn() && (
            isAdmin() || (
              callerManagesTeam(classId)
            )
          );
          allow delete: if isAdmin();
        }
      }
    }

    // ═══════════════════════════════════════════════════════════════
    // ATTENDANCE COLLECTION (canonical: /attendance/{sessionId})
    // ═══════════════════════════════════════════════════════════════

    match /attendance/{sessionId} {
      allow read: if isSignedIn() && (
        isAdmin() || callerManagesTeam(resource.data.teamId)
      );
      allow create: if isSignedIn() && (
        isAdmin() || callerManagesTeam(request.resource.data.teamId)
      );
      allow update: if isSignedIn() && (
        isAdmin() || callerManagesTeam(resource.data.teamId)
      );
      allow delete: if isAdmin();

      match /records/{markId} {
        function sessionData() {
          return get(/databases/$(database)/documents/attendance/$(sessionId)).data;
        }

        allow read: if isSignedIn() && (
          isAdmin() ||
          callerManagesTeam(sessionData().teamId) ||
          uid() == markId.split('_')[0]
        );

        allow create, update: if isSignedIn() && (
          isAdmin() || (
            callerManagesTeam(sessionData().teamId) &&
            markId.split('_')[0] in
              sessionData().get('studentIdsSnapshot', [])
          )
        );

        allow delete: if isAdmin();
      }
    }

    // ═══════════════════════════════════════════════════════════════
    // RESULTS COLLECTION
    // ═══════════════════════════════════════════════════════════════

    match /results/{studentId} {
      allow read: if isSignedIn() && (
        studentId == uid() ||
        isAdmin() ||
        (isServantOrAdmin() && callerManagesStudentSector(get(/databases/$(database)/documents/Students/$(studentId)).data))
      );
      allow write: if isAdmin() || (
        isServantOrAdmin() &&
        callerManagesStudentSector(get(/databases/$(database)/documents/Students/$(studentId)).data)
      );

      match /terms/{termId} {
        allow read: if isSignedIn() && (
          studentId == uid() ||
          isAdmin() ||
          (isServantOrAdmin() && callerManagesStudentSector(get(/databases/$(database)/documents/Students/$(studentId)).data))
        );
        allow write: if isAdmin() || (
          isServantOrAdmin() &&
          callerManagesStudentSector(get(/databases/$(database)/documents/Students/$(studentId)).data)
        );
      }
    }

    // ═══════════════════════════════════════════════════════════════
    // SECTORS ANALYTICS (Pre-aggregated, read-only for authorized users)
    // ═══════════════════════════════════════════════════════════════

    match /SectorsAnalytics/{sectorId} {
      // Admin reads all; servants read only their assigned sectors.
      // Students: ZERO access.
      allow read: if isSignedIn() && (
        isAdmin() ||
        callerManagesSector(sectorId)
      );

      // Client writes FORBIDDEN — updated via Admin SDK or batch closure.
      allow write: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    // SUPPORTING COLLECTIONS
    // ═══════════════════════════════════════════════════════════════

    match /team_uniqueness_registry/{registryId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /Invitations/{email} {
      allow read, write: if isAdmin();
    }

    match /admin/{document=**} {
      allow read, write: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    // COLLECTION GROUP RULES (Required for global collection group queries)
    // ═══════════════════════════════════════════════════════════════

    match /{path=**}/attendance/{sessionId} {
      allow read: if isSignedIn() && (
        isAdmin() || callerManagesTeam(resource.data.teamId)
      );
    }

    match /{path=**}/records/{markId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.studentId == uid() ||
        callerManagesTeam(resource.data.teamId)
      );
    }

    match /{path=**}/terms/{termId} {
      allow read: if isSignedIn() && (
        resource.data.studentId == uid() ||
        isAdmin() ||
        (isServantOrAdmin() && callerManagesStudentSector(get(/databases/$(database)/documents/Students/$(resource.data.studentId)).data))
      );
    }
  }
}