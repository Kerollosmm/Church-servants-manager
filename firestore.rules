rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ──────────────────────────────────────────────────────────────────
    // CANONICAL PERMISSION MATRIX ENFORCEMENT (Zero-Cost RBAC)
    // ──────────────────────────────────────────────────────────────────

    // ─── Helper Functions ──────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function callerUid() {
      return request.auth.uid;
    }

    // Get user document from Firestore (Source of Truth)
    function getUserData() {
      return get(/databases/$(database)/documents/Users/$(callerUid())).data;
    }

    function isAdmin() {
      let user = getUserData();
      return isSignedIn() && 
             user.get('isArchived', false) == false && 
             user.get('role', 'none') == 'admin';
    }

    function isServant() {
      let user = getUserData();
      return isSignedIn() && 
             user.get('isArchived', false) == false && 
             user.get('role', 'none') == 'servant';
    }

    function isStudent() {
      let user = getUserData();
      return isSignedIn() && 
             user.get('isArchived', false) == false && 
             user.get('role', 'none') == 'student';
    }

    // ─── Collection/Team Helpers ──────────────────────────────────

    function getClassData(classId) {
      return get(/databases/$(database)/documents/Classes/$(classId)).data;
    }

    function servantCanManageTeam(classId) {
      let user = getUserData();
      return isServant() && (
        user.get('assignedTeamId', null) == classId || 
        classId in user.get('assignedTeamIds', []) ||
        (user.get('groupId', null) != null && getClassData(classId).get('groupId', null) == user.get('groupId', null))
      );
    }

    // ─── Student Helpers ──────────────────────────────────────────

    function servantCanReadStudent(studentData) {
      let user = getUserData();
      let assignedTeams = user.get('assignedTeamIds', []) + (user.get('assignedTeamId', null) != null ? [user.get('assignedTeamId', null)] : []);
      return isServant() && studentData != null && (
        (
          assignedTeams.size() > 0 && 
          studentData.get('classId', null) != null && 
          studentData.get('classId', null) in assignedTeams
        ) ||
        (
          user.get('groupId', null) != null && 
          studentData.get('group', null) == user.get('groupId', null)
        )
      );
    }

    function servantCanManageStudent(studentData) {
      return isServant() && studentData != null && 
             studentData.get('isArchived', false) != true &&
             servantCanReadStudent(studentData);
    }

    // ─── Session Helpers ──────────────────────────────────────────

    function sessionAcceptsLiveMarks(session) {
      return session != null &&
        session.get('isClosed', false) != true &&
        request.time >= session.startsAt - duration.value(5, 'm') &&
        request.time < session.endsAt;
    }

    function sessionAcceptsAdminCorrection(session) {
      return session != null &&
        isAdmin() &&
        session.get('isReopenedForAdminEdit', false) == true;
    }

    // ─── Validation Functions ─────────────────────────────────────

    function validSelfUserUpdate(userId) {
      return callerUid() == userId &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'email', 'isEmailVerified', 'updatedAt', 'phone', 'avatarUrl'
        ]);
    }

    function isPrivilegedFieldUpdate() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return affected.hasAny([
        'role', 'isArchived', 'attendanceSummary', 'groupAttendanceSummary', 'aiRecommendations'
      ]);
    }

    function isStudentInClass(classId) {
      return isStudent() && getUserData().get('assignedTeamId', '') == classId;
    }

    function isStudentInSessionRoster(classId, sessionId, studentId) {
      let session = get(/databases/$(database)/documents/Classes/$(classId)/attendance_sessions/$(sessionId)).data;
      return studentId in session.get('studentIdsSnapshot', []);
    }

    // ─── Users Collection ─────────────────────────────────────────
    match /Users/{userId} {
      allow read: if isSignedIn() && (
        callerUid() == userId || 
        isAdmin()
      );

      allow create: if isSignedIn() && (
        isAdmin() || (callerUid() == userId && request.resource.data.role == 'student')
      );

      allow update: if isSignedIn() && (
        isAdmin() || (validSelfUserUpdate(userId) && !isPrivilegedFieldUpdate())
      );

      allow delete: if isAdmin();
    }

    // ─── Students Collection ──────────────────────────────────────
    match /Students/{studentId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        servantCanReadStudent(resource.data) ||
        (isStudent() && resource.data.uid == callerUid())
      );

      allow create: if isSignedIn() && (
        isAdmin() || (isServant() && servantCanManageStudent(request.resource.data))
      );

      allow update: if isSignedIn() && (
        isAdmin() || (
          isServant() && 
          servantCanManageStudent(resource.data) && 
          !isPrivilegedFieldUpdate() &&
          // Constrain servant updates to non-sensitive student fields
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'phone', 'birthDate', 'address', 'parentPhone', 'avatarUrl', 'notes', 'grade'
          ])
        )
      );

      allow delete: if isAdmin();
    }

    // ─── Classes (Teams) Collection ───────────────────────────────
    match /Classes/{classId} {
      allow read: if isSignedIn() && (
        isAdmin() || isServant() || isStudentInClass(classId)
      );

      allow create, update, delete: if isAdmin();

      // Attendance Sessions
      match /attendance_sessions/{sessionId} {
        allow read: if isSignedIn() && (isAdmin() || servantCanManageTeam(classId));
        
        allow create: if isSignedIn() && (isAdmin() || servantCanManageTeam(classId));

        allow update: if isAdmin();
        allow delete: if isAdmin();

        // Attendance Marks
        match /marks/{studentDocId} {
          allow read: if isSignedIn() && (isAdmin() || servantCanManageTeam(classId));

          allow create, update: if isSignedIn() && (
            isAdmin() || 
            (
              servantCanManageTeam(classId) && 
              isStudentInSessionRoster(classId, sessionId, studentDocId) &&
              (
                sessionAcceptsLiveMarks(get(/databases/$(database)/documents/Classes/$(classId)/attendance_sessions/$(sessionId)).data) ||
                sessionAcceptsAdminCorrection(get(/databases/$(database)/documents/Classes/$(classId)/attendance_sessions/$(sessionId)).data)
              )
            )
          );

          allow delete: if isAdmin();
        }
      }
    }

    // ─── Attendance Records (Offline Sync) ────────────────────────
    match /attendanceRecords/{recordId} {
      allow read: if isSignedIn() && (
        isAdmin() || 
        (isServant() && resource.data.servantId == callerUid())
      );
      
      allow write: if isSignedIn() && (
        isAdmin() || 
        (
          isServant() && 
          request.resource.data.servantId == callerUid() &&
          servantCanManageTeam(request.resource.data.classId) &&
          isStudentInSessionRoster(request.resource.data.classId, request.resource.data.sessionId, request.resource.data.studentId)
        )
      );
    }

    // ─── Team Uniqueness Registry ─────────────────────────────────
    match /team_uniqueness_registry/{registryId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ─── Default Deny Rule ────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
