rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ───────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function callerUid() {
      return request.auth.uid;
    }

    function callerUser() {
      let userPath = /databases/$(database)/documents/Users/$(callerUid());
      return exists(userPath) ? get(userPath).data : {};
    }

    function isAdmin() {
      let user = callerUser();
      return isSignedIn() && user.get('isArchived', false) == false && user.get('role', 'none') == 'admin';
    }

    function isServant() {
      let user = callerUser();
      return isSignedIn() && user.get('isArchived', false) == false && user.get('role', 'none') == 'servant';
    }

    function teamIsActive(teamId) {
      let path = /databases/$(database)/documents/Classes/$(teamId);
      return exists(path) && get(path).data.get('isArchived', false) == false;
    }

    function studentIsActive(studentId) {
      let path = /databases/$(database)/documents/Students/$(studentId);
      return exists(path) && get(path).data.get('isArchived', false) == false;
    }

    function servantCanReadStudent() {
      let user = callerUser();
      let studentGroup = resource.data.get('group', null);
      let studentClassId = resource.data.get('classId', null);
      let assignedTeamIds = user.get('assignedTeamIds', []);
      let userGroupId = user.get('groupId', null);
      let userAssignedTeamId = user.get('assignedTeamId', null);

      return isServant() && (
        (studentGroup != null && userGroupId != null && studentGroup == userGroupId) ||
        (studentClassId != null && (
          studentClassId == userAssignedTeamId ||
          (assignedTeamIds is list && studentClassId in assignedTeamIds)
        ))
      );
    }

    function servantCanManageTeam(teamId) {
      let user = callerUser();
      let assignedTeamIds = user.get('assignedTeamIds', []);
      let userAssignedTeamId = user.get('assignedTeamId', null);

      return isServant() && (
        userAssignedTeamId == teamId ||
        (assignedTeamIds is list && teamId in assignedTeamIds)
      );
    }

    function servantCanManageStudentPayload(studentData) {
      let user = callerUser();
      let studentGroup = studentData.get('group', null);
      let studentClassId = studentData.get('classId', null);
      let isArchived = studentData.get('isArchived', false);
      let assignedTeamIds = user.get('assignedTeamIds', []);
      let userGroupId = user.get('groupId', null);
      let userAssignedTeamId = user.get('assignedTeamId', null);

      return isServant() && isArchived == false && (
        (studentGroup != null && userGroupId != null && studentGroup == userGroupId) ||
        (studentClassId != null && (
          studentClassId == userAssignedTeamId ||
          (assignedTeamIds is list && studentClassId in assignedTeamIds)
        ))
      );
    }

    function validSelfUserUpdate(userId) {
      return callerUid() == userId &&
        request.resource.data.get('uid', '') == resource.data.get('uid', '') &&
        request.resource.data.get('role', '') == resource.data.get('role', '') &&
        request.resource.data.get('email', '') == resource.data.get('email', '') &&
        request.resource.data.get('isEmailVerified', false) == resource.data.get('isEmailVerified', false) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'updatedAt',
        ]) &&
        request.resource.data.get('name', '') is string &&
        request.resource.data.get('name', '').size() > 0;
    }

    function sessionAcceptsMarks(teamId, sessionId) {
      let sessionPath = /databases/$(database)/documents/Classes/$(teamId)/attendance_sessions/$(sessionId);
      let sessionExists = exists(sessionPath);
      let session = sessionExists ? get(sessionPath).data : {};

      return sessionExists &&
        teamIsActive(teamId) &&
        session.get('isClosed', false) == false &&
        request.time >= session.get('startsAt', request.time) &&
        request.time < session.get('endsAt', request.time + duration.value(1, 's'));
    }

    function validAttendanceSessionPayload(teamId) {
      return request.resource.data.keys().hasOnly([
          'teamId',
          'teamNameSnapshot',
          'title',
          'dateKey',
          'startsAt',
          'endsAt',
          'durationMinutes',
          'createdByUserId',
          'createdByName',
          'createdAt',
          'updatedAt',
          'isClosed',
          'studentIdsSnapshot',
          'studentNameSnapshots',
        ]) &&
        request.resource.data.get('teamId', '') == teamId &&
        request.resource.data.get('createdByUserId', '') == callerUid() &&
        request.resource.data.get('durationMinutes', 0) is int &&
        request.resource.data.get('durationMinutes', 0) > 0;
    }

    function validAttendanceMarkPayload(studentId) {
      return request.resource.data.keys().hasOnly([
          'studentNameSnapshot',
          'status',
          'markedByUserId',
          'markedByName',
          'markedAt',
          'updatedAt',
          'note',
        ]) &&
        studentIsActive(studentId) &&
        request.resource.data.get('markedByUserId', '') == callerUid() &&
        request.resource.data.get('markedByName', '') is string &&
        request.resource.data.get('markedByName', '').size() > 0 &&
        request.resource.data.get('studentNameSnapshot', '') is string &&
        request.resource.data.get('studentNameSnapshot', '').size() > 0 &&
        request.resource.data.get('status', '') in ['present', 'late'];
    }

    // ─── Users ─────────────────────────────────────────────────────
    match /Users/{userId} {
      allow read: if isSignedIn() && (callerUid() == userId || isAdmin());
      allow create: if isAdmin();
      allow update: if isSignedIn() && (isAdmin() || validSelfUserUpdate(userId));
      allow delete: if isAdmin();
    }

    // ─── Students ──────────────────────────────────────────────────
    match /Students/{studentId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        servantCanReadStudent() ||
        resource.data.get('uid', '') == callerUid()
      );

      allow create: if isSignedIn() && (
        isAdmin() ||
        (
          servantCanManageStudentPayload(request.resource.data) &&
          request.resource.data.get('role', '') == 'student'
        )
      );

      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          servantCanManageStudentPayload(resource.data) &&
          servantCanManageStudentPayload(request.resource.data) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'uid'])
        )
      );

      allow delete: if isAdmin();
    }

    // ─── Classes (Teams) ───────────────────────────────────────────
    match /Classes/{classId} {
      allow read: if isSignedIn() && (isAdmin() || isServant());
      allow create, update, delete: if isAdmin();

      match /attendance_sessions/{sessionId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          servantCanManageTeam(classId) ||
          (resource.data.studentIdsSnapshot is list && callerUid() in resource.data.studentIdsSnapshot)
        );
        allow create: if teamIsActive(classId) && (
          isAdmin() ||
          servantCanManageTeam(classId)
        ) && validAttendanceSessionPayload(classId);
        allow update, delete: if isAdmin();

        match /marks/{studentId} {
          allow read: if isSignedIn() && (
            isAdmin() ||
            servantCanManageTeam(classId) ||
            studentId == callerUid()
          );
          allow create, update: if (isAdmin() || servantCanManageTeam(classId)) &&
            sessionAcceptsMarks(classId, sessionId) &&
            validAttendanceMarkPayload(studentId);
          allow delete: if (isAdmin() || servantCanManageTeam(classId)) &&
            sessionAcceptsMarks(classId, sessionId);
        }
      }
    }

    // Collection Group rules for attendance sessions
    match /{path=**}/attendance_sessions/{sessionId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        servantCanManageTeam(resource.data.teamId) ||
        (resource.data.studentIdsSnapshot is list && callerUid() in resource.data.studentIdsSnapshot)
      );
    }

    // ─── Server-Only Collections (deny all client writes) ─────────
    match /audit_logs/{document=**} {
      allow read: if isAdmin();
      allow write: if false;  
    }

    match /attendance_history/{document=**} {
      allow read: if isSignedIn();
      allow write: if false;  
    }

    match /attendance_stats/{document=**} {
      allow read: if isSignedIn();
      allow write: if false;  
    }

    match /RollbackLogs/{document=**} {
      allow read: if isAdmin();
      allow write: if false;  
    }
  }
}