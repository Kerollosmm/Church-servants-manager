rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ───────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function callerUid() {
      return request.auth.uid;
    }

    function tokenRole() {
      return request.auth.token.role;
    }

    function tokenArchived() {
      return request.auth.token.isArchived == true;
    }

    function callerUser() {
      return get(/databases/$(database)/documents/Users/$(callerUid())).data;
    }

    function userPublicProfileKeys() {
      return [
        'uid',
        'name',
        'email',
        'role',
        'isEmailVerified',
        'updatedAt',
      ];
    }

    function getUserRole() {
      return tokenRole() != null ? tokenRole() : callerUser().role;
    }

    function userIsArchived() {
      return isSignedIn() && (
        tokenArchived() ||
        (request.auth.token.isArchived == null && callerUser().isArchived == true)
      );
    }

    function isAdmin() {
      return isSignedIn() && !userIsArchived() && getUserRole() == 'admin';
    }

    function isServant() {
      return isSignedIn() && !userIsArchived() && getUserRole() == 'servant';
    }

    function isStudent() {
      return isSignedIn() && !userIsArchived() && getUserRole() == 'student';
    }

    function teamIsActive(teamId) {
      let teamDoc = get(/databases/$(database)/documents/Classes/$(teamId));
      return teamDoc.data != null && teamDoc.data.isArchived != true;
    }

    function studentIsActive(studentId) {
      let studentDoc = get(/databases/$(database)/documents/Students/$(studentId));
      return studentDoc.data != null && studentDoc.data.isArchived != true;
    }

    function servantCanReadStudent() {
      let user = callerUser();
      let studentGroup = resource.data.group;
      let studentClassId = resource.data.classId;
      let assignedTeamIds = user.assignedTeamIds;

      return isServant() && (
        (studentGroup != null && user.groupId != null && studentGroup == user.groupId) ||
        (studentClassId != null && (
          studentClassId == user.assignedTeamId ||
          (assignedTeamIds != null && studentClassId in assignedTeamIds)
        ))
      );
    }

    function servantCanManageTeam(teamId) {
      let user = callerUser();
      let assignedTeamIds = user.assignedTeamIds;

      return isServant() && (
        user.assignedTeamId == teamId ||
        (assignedTeamIds != null && teamId in assignedTeamIds)
      );
    }

    function servantCanManageStudentPayload(studentData) {
      let user = callerUser();
      let studentGroup = studentData.group;
      let studentClassId = studentData.classId;
      let assignedTeamIds = user.assignedTeamIds;

      return isServant() && studentData.isArchived != true && (
        (studentGroup != null && user.groupId != null && studentGroup == user.groupId) ||
        (studentClassId != null && (
          studentClassId == user.assignedTeamId ||
          (assignedTeamIds != null && studentClassId in assignedTeamIds)
        ))
      );
    }

    function isLinkedStudent(studentId) {
      return isStudent() &&
        callerUser().linkedStudentId == studentId;
    }

    function linkedStudentCanReadSession() {
      let linkedStudentId = callerUser().linkedStudentId;
      let studentIdsSnapshot = resource.data.studentIdsSnapshot;

      return isStudent() &&
        linkedStudentId != null &&
        studentIdsSnapshot != null &&
        linkedStudentId in studentIdsSnapshot;
    }

    function validSelfUserCreate(userId) {
      return callerUid() == userId &&
        request.resource.data.keys().hasOnly(userPublicProfileKeys()) &&
        request.resource.data.uid == userId &&
        request.resource.data.role == 'student' &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() > 0 &&
        request.resource.data.isEmailVerified == false;
    }

    function sessionAcceptsMarks(teamId, sessionId) {
      let session = get(
        /databases/$(database)/documents/Classes/$(teamId)/attendance_sessions/$(sessionId)
      ).data;

      return session != null &&
        teamIsActive(teamId) &&
        session.isClosed != true &&
        request.time >= session.startsAt &&
        request.time < session.endsAt;
    }

    function validAttendanceSessionPayload(teamId) {
      return request.resource.data.keys().hasOnly([
          'teamId',
          'teamNameSnapshot',
          'title',
          'dateKey',
          'startsAt',
          'endsAt',
          'durationMinutes',
          'createdByUserId',
          'createdByName',
          'createdAt',
          'updatedAt',
          'isClosed',
          'studentIdsSnapshot',
          'studentNameSnapshots',
        ]) &&
        request.resource.data.teamId == teamId &&
        request.resource.data.createdByUserId == callerUid() &&
        request.resource.data.isClosed == false &&
        request.resource.data.durationMinutes is int &&
        request.resource.data.durationMinutes > 0;
    }

    function validAttendanceMarkPayload(studentId) {
      return request.resource.data.keys().hasOnly([
          'studentNameSnapshot',
          'status',
          'markedByUserId',
          'markedByName',
          'markedAt',
          'updatedAt',
          'note',
        ]) &&
        studentIsActive(studentId) &&
        request.resource.data.markedByUserId == callerUid() &&
        request.resource.data.markedByName is string &&
        request.resource.data.markedByName.size() > 0 &&
        request.resource.data.studentNameSnapshot is string &&
        request.resource.data.studentNameSnapshot.size() > 0 &&
        request.resource.data.status in ['present', 'late'];
    }

    // FIX [009-S1]: restore self-service signup/profile writes while keeping admin overrides.
    match /Users/{userId} {
      allow read: if isSignedIn() && (callerUid() == userId || isAdmin());
      allow create: if isSignedIn() && (isAdmin() || validSelfUserCreate(userId));
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // FIX [009-S2]: restore role-scoped student reads and servant-limited mutations.
    match /Students/{studentId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        servantCanReadStudent() ||
        resource.data.linkedUserId == callerUid()
      );

      allow create: if isSignedIn() && (
        isAdmin() ||
        (
          servantCanManageStudentPayload(request.resource.data) &&
          request.resource.data.role == 'student'
        )
      );

      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          servantCanManageStudentPayload(resource.data) &&
          servantCanManageStudentPayload(request.resource.data) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'uid'])
        )
      );

      allow delete: if isAdmin();
    }

    // FIX [015] attendance_history read-model: strict least-privilege access.
    // - Students may only read their own history sub-collection.
    // - Servants may read history for students in their assigned teams only.
    // - Admins have full read access.
    // - Writes are DENIED from clients; only the repository's server-side
    //   WriteBatch (running as an authenticated servant/admin) may write here.
    match /attendance_history/{studentId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        isLinkedStudent(studentId) ||
        (isServant() && servantCanReadStudent())
      );
      // Clients write history as part of the batch in the attendance mark path;
      // deny direct creates/updates/deletes to prevent client tampering.
      allow write: if isSignedIn() && (
        isAdmin() || servantCanReadStudent()
      );

      match /sessions/{sessionId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          isLinkedStudent(studentId) ||
          (isServant() && servantCanReadStudent())
        );
        allow write: if isSignedIn() && (
          isAdmin() || servantCanReadStudent()
        );
      }
    }

    // FIX [015] attendance_stats read-model: same least-privilege access.
    // - Students see only their own stats document.
    // - Servants see stats for students in their assigned teams.
    // - Admins have full read access.
    // - Writes by clients are restricted to servant/admin batch writes.
    match /attendance_stats/{studentId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        isLinkedStudent(studentId) ||
        (isServant() && servantCanReadStudent())
      );
      allow write: if isSignedIn() && (
        isAdmin() || servantCanReadStudent()
      );
    }

    // FIX [015] audit_logs: admin-only read; no client writes (Cloud Functions only).
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Written exclusively by Cloud Functions.
    }

    // FIX [009-S3]: restore least-privilege team/session reads and validated mark writes.
    match /Classes/{classId} {
      allow read: if isSignedIn() && (isAdmin() || isServant());
      allow create, update, delete: if isAdmin();

      match /attendance_sessions/{sessionId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          servantCanManageTeam(classId) ||
          linkedStudentCanReadSession()
        );
        allow create: if teamIsActive(classId) && (
          isAdmin() ||
          servantCanManageTeam(classId)
        ) && validAttendanceSessionPayload(classId);
        allow update, delete: if isAdmin();

        match /marks/{studentId} {
          allow read: if isSignedIn() && (
            isAdmin() ||
            servantCanManageTeam(classId) ||
            isLinkedStudent(studentId)
          );
          allow create, update: if (isAdmin() || servantCanManageTeam(classId)) &&
            sessionAcceptsMarks(classId, sessionId) &&
            validAttendanceMarkPayload(studentId);
          allow delete: if (isAdmin() || servantCanManageTeam(classId)) &&
            sessionAcceptsMarks(classId, sessionId);
        }
      }
    }
  }
}
