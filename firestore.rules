rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function hasRole(role) {
      return isAuthenticated() && request.auth.token.role == role;
    }

    function isStudentOwner(studentId) {
      return isAuthenticated() && request.auth.uid == studentId;
    }

    match /servants/{uid} {
      allow read: if isAuthenticated();
      allow write: if hasRole('admin');
    }

    match /Students/{studentId} {
      allow read: if isStudentOwner(studentId) || hasRole('servant') || hasRole('admin');
      allow write: if hasRole('servant') || hasRole('admin');

      match /PointsLedger/{transactionId} {
        allow read: if isStudentOwner(studentId) || hasRole('servant') || hasRole('admin');
        allow write: if hasRole('servant') || hasRole('admin');
      }
    }

    match /AttendanceSessions/{sessionId} {
      allow read, write: if hasRole('servant') || hasRole('admin');

      match /marks/{studentDocId} {
        allow read: if isStudentOwner(resource.data.studentId) || hasRole('servant') || hasRole('admin');
        allow write: if hasRole('servant') || hasRole('admin');
      }
    }

    match /attendance_marks/{markId} {
      allow read: if isStudentOwner(resource.data.studentId) || hasRole('servant') || hasRole('admin');
      allow write: if hasRole('servant') || hasRole('admin');
    }
  }
}
